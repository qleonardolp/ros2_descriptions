<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hyq_control" params="fixed_support">
    <xacro:property name="robot_yaml" value="$(find ros2_descriptions)/config/hyl.yaml"/>
    <xacro:property name="config" value="${xacro.load_yaml(robot_yaml)}"/>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ros2_descriptions)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <ros2_control name="HyLSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:unless value="${fixed_support}">
        <joint name="support_joint">
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:unless>

      <joint name="hfe_joint">
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">${config['initial']['hfe_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="kfe_joint">
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">${config['initial']['kfe_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
