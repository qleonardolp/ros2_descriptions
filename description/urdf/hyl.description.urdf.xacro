<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="HyL">

	<link name="trunk">
		<visual>
			<origin xyz="0 0 0" rpy="-1.5707963267948966 3.141592653589793 0"/>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/trunk.dae" scale="1 1 1"/>
			</geometry>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="-1.5707963267948966 3.141592653589793 0"/>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/trunk.dae" scale="1 1 1"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="-0.08315 0.06849 -0.00654"/>
			<mass value="7.982"/>
			<inertia
        ixx="0.037131" iyy="0.087473" izz="0.112496"
				ixy="0.028543" ixz="-0.00097"
        iyz="0.003392"/>
		</inertial>
	</link>

	<joint name="haa_joint" type="fixed">
		<origin xyz="0 0.13 0" rpy="0 1.5707963267948966 3.141592653589793"/> 
		<parent link="trunk"/>
		<child link="hip"/>
	</joint>

  <link name="hip">
    <visual>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/hipassembly.dae" scale="1 1 1"/>
			</geometry>
    </visual>
    <collision>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/hipassembly.dae" scale="1 1 1"/>
			</geometry>
    </collision>
		<inertial>
			<origin xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia
        ixx="0.001" iyy="0.001" izz="0.001"
				ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
  </link>

  <joint name="hfe_joint" type="revolute">
    <origin xyz="0.08 0.0 0.0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="hip"/>
    <child link="upperleg"/>
		<limit effort="150.0" velocity="12.0" lower="-0.87266462599" upper="1.22173047639"/>
		<safety_controller k_position="100" k_velocity="100" soft_lower_limit="-0.87266462599" soft_upper_limit="1.22173047639"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="upperleg">
    <visual>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/upperleg.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/upperleg.dae" />
      </geometry>
    </collision>
		<inertial>
			<origin xyz="0.14925 -0.02996 -0.00005"/>
			<mass value="2.06218"/>
			<inertia
        ixx="0.00464" iyy="0.07216" izz="0.07463"
				ixy="-0.00718" ixz="-0.00001"
        iyz="-0.00001"/>
		</inertial>
  </link>

  <joint name="kfe_joint" type="revolute">
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="upperleg"/>
    <child link="lowerleg"/>
    <limit effort="150.0" velocity="12.0" lower="-2.44346095279" upper="-0.34906585039"/>
		<safety_controller k_position="100" k_velocity="100" soft_lower_limit="-2.44346095279" soft_upper_limit="-0.34906585039"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="lowerleg">
    <visual>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/lowerleg.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/lowerleg.dae" />
      </geometry>
    </collision>
		<inertial>
			<origin xyz="0.12185 0.00058 -0.00012"/>
			<mass value="0.80669"/>
			<inertia
        ixx="0.00042" iyy="0.02202" izz="0.02183"
				ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
  </link>

  <joint name="foot_transform" type="fixed">
    <origin xyz="0.341 0 0" rpy="1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="lowerleg"/>
    <child link="foot" />
  </joint>

	<link name="foot">
		<collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<sphere radius="0.02185"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0 0 0"/>
			<mass value="0.01"/>
			<inertia
        ixx="0.0" iyy="0.0" izz="0.0"
        ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
	</link>

</robot>
