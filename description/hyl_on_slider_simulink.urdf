<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="HyL_Simulink">

  <link name="world">
    <visual>
      <origin xyz="0.0 0.0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="1.20 0.80 0.04"/>
      </geometry>
      <material name="StaticYellow">
        <color rgba="0.80 0.81 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.0 0.0 1.0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.08 2.0"/>
      </geometry>
      <material name="StaticYellow">
        <color rgba="0.80 0.81 0.0 0.7"/>
      </material>
    </visual>
  </link>

  <joint name="support_joint" type="prismatic">
    <origin xyz="0.0 0.04 0.5" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <parent link="world"/>
    <child link="trunk"/>
      <limit effort="10000" velocity="340.0" lower="-0.15" upper="2.60"/>
      <dynamics damping="0.08"/>
  </joint>

	<link name="trunk">
		<visual>
			<origin xyz="0 0 0" rpy="-1.5707963267948966 3.141592653589793 0"/>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/trunk.dae"/>
			</geometry>
		</visual>
		<inertial>
			<origin xyz="-0.08315 0.06849 -0.00654"/>
			<mass value="7.982"/>
			<inertia
        ixx="0.037131" iyy="0.087473" izz="0.112496"
				ixy="0.028543" ixz="-0.00097"
        iyz="0.003392"/>
		</inertial>
	</link>

	<joint name="haa_joint" type="fixed">
		<origin xyz="0 0.13 0" rpy="0 1.5707963267948966 3.141592653589793"/> 
		<parent link="trunk"/>
		<child link="hip"/>
	</joint>

  <link name="hip">
    <visual>
			<geometry>
				<mesh filename="package://ros2_descriptions/description/meshes/hyl/hipassembly.dae"/>
			</geometry>
    </visual>
		<inertial>
			<origin xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia
        ixx="0.001" iyy="0.001" izz="0.001"
				ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
  </link>

  <joint name="hfe_joint" type="revolute">
    <origin xyz="0.08 0.0 0.0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="hip"/>
    <child link="upperleg"/>
		<limit effort="150.0" velocity="12.0" lower="-0.87266462599" upper="1.22173047639"/>
    <dynamics damping="0.0"/>
  </joint>

  <link name="upperleg">
    <visual>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/upperleg.dae"/>
      </geometry>
      <material name="Purple">
        <color rgba="0.6039 0.38 0.7333 1.0"/>
      </material>
    </visual>
		<inertial>
			<origin xyz="0.14925 -0.02996 -0.00005"/>
			<mass value="2.06218"/>
			<inertia
        ixx="0.00464" iyy="0.07216" izz="0.07463"
				ixy="-0.00718" ixz="-0.00001"
        iyz="-0.00001"/>
		</inertial>
  </link>

  <joint name="kfe_joint" type="revolute">
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="upperleg"/>
    <child link="lowerleg"/>
    <limit effort="150.0" velocity="12.0" lower="-2.44346095279" upper="-0.34906585039"/>
    <dynamics damping="0.0"/>
  </joint>

  <link name="lowerleg">
    <visual>
      <geometry>
        <mesh filename="package://ros2_descriptions/description/meshes/hyl/lowerleg.dae"/>
      </geometry>
      <material name="LightTeal">
        <color rgba="0.0 0.81 0.68 1.0"/>
      </material>
    </visual>
		<inertial>
			<origin xyz="0.12185 0.00058 -0.00012"/>
			<mass value="0.80669"/>
			<inertia
        ixx="0.00042" iyy="0.02202" izz="0.02183"
				ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
  </link>

  <joint name="foot_transform" type="fixed">
    <origin xyz="0.341 0 0" rpy="1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="lowerleg"/>
    <child link="foot" />
  </joint>

	<link name="foot">
		<inertial>
			<origin xyz="0 0 0"/>
			<mass value="0.01"/>
			<inertia
        ixx="0.0" iyy="0.0" izz="0.0"
        ixy="0.0" ixz="0.0"
        iyz="0.0"/>
		</inertial>
	</link>
</robot>
